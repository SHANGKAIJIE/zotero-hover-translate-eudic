pref-title = Hover Translate Eudic

pref-section-basic = 基础功能设置
pref-enableHoverTranslate =
    .label = 启用悬停翻译（插件总开关）
pref-triggerMode = 取词触发方式：
pref-triggerMode-hover =
    .label = 鼠标悬停
pref-triggerMode-modifier =
    .label = 修饰键 + 悬停
pref-triggerMode-click =
    .label = 鼠标左键单击
pref-modifierKeys = 修饰键组合：
pref-modifierCtrl =
    .label = Ctrl
pref-modifierAlt =
    .label = Alt
pref-modifierShift =
    .label = Shift
pref-enableHighlight =
    .label = 取词高亮（临时高亮匹配单词，不修改 PDF）
pref-highlightColor = 高亮颜色：
pref-highlightColorAlpha = 透明度：
pref-highlightColorA-unit = %
pref-hoverDelay = 悬停触发延迟：
pref-hoverDelay-unit = 毫秒
pref-popupPosition = 弹窗位置：
pref-popupPosition-top =
    .label = 单词上方
pref-popupPosition-bottom =
    .label = 单词下方
pref-popupAutoCloseDelay = 弹窗自动关闭：
pref-popupAutoCloseDelay-unit = 秒（0=不自动关闭）
pref-translateDisplayMode = 翻译显示模式：
pref-translateDisplayMode-simple =
    .label = 简洁（仅译文）
pref-translateDisplayMode-full =
    .label = 完整（译文+字典释义）
pref-translateEngine = 译文引擎：
pref-translateEngine-dict =
    .label = 字典引擎（更快，取首条释义）
pref-translateEngine-translate =
    .label = 翻译引擎（稍慢，释义更贴切）
pref-translateEngine-hint =
    .value = 翻译引擎复用Translate插件，若翻译结果[请求错误]，可去该插件切换翻译引擎
pref-disableOnSelection =
    .label = 划词时禁用悬停弹窗（避免与划词翻译弹窗冲突）

pref-section-eudic = 生词本设置
pref-wordbookPlatform = 生词本平台：
pref-wordbookPlatform-eudic =
    .label = 欧路词典
pref-wordbookPlatform-maimemo =
    .label = 墨墨背单词
pref-wordbookPlatform-local =
    .label = 本地生词表
pref-wordbookPlatform-shanbay =
    .label = 扇贝单词
pref-wordbookPlatform-zotero =
    .label = Zotero 笔记
pref-zoteroNoteName = 笔记名称：
pref-zoteroNote-edit =
    .label = 打开笔记
pref-shanbayToken = Auth Token：
pref-shanbayToken-apply = 浏览器需安装 HTE-Bridge 浏览器插件 并登录扇贝网页
pref-enableEudicSync =
    .label = 启用生词本同步（翻译弹窗显示「+生词本」按钮）
pref-eudicToken = API Token：
pref-eudicToken-apply = 申请欧路 OpenAPI Token（带 NIS 前缀）
pref-maimemoToken = API Token：
pref-maimemoToken-apply = 申请墨墨开放平台 Access Token
pref-maimemoToken-24h-hint =
    .value = 注意：墨墨 Token 有效期仅 24 小时，过期后需重新获取
pref-maimemoToken-hte-bridge = 可选择安装 HTE-Bridge 浏览器插件，保持 Token 自动更新和输入
pref-localSavePath = 存储路径：
pref-localSavePath-placeholder = 留空则保存在 Zotero 配置目录
pref-local-chooseDir =
    .label = 选择目录
pref-local-chooseDir-label = 选择存储目录
pref-eudicCategory = 选择生词本：
pref-eudicCategory-refresh =
    .label = 刷新列表
pref-eudicCategory-edit =
    .label = 编辑词本
pref-eudicLanguage = 单词语言：
pref-buttonShowScene = 按钮显示场景：
pref-buttonShowScene-both =
    .label = 悬停 + 划词都显示
pref-buttonShowScene-hover =
    .label = 仅悬停翻译显示
pref-buttonShowScene-selection =
    .label = 仅划词翻译显示
pref-wordButtonPosition = 按钮显示位置：
pref-wordButtonPosition-left =
    .label = 弹窗左侧
pref-wordButtonPosition-right =
    .label = 弹窗右侧
pref-addWordMode = 加词方式：
pref-addWordMode-manual =
    .label = 手动点击按钮添加
pref-addWordMode-auto =
    .label = 翻译后自动加入生词本
pref-addWordShortcut = 加词快捷键：
pref-addWordShortcut-hint =
    .value = 留空则不启用快捷键
pref-lemmaMode = 词形选择：
pref-lemmaMode-lemma =
    .label = 还原为单词原型
pref-lemmaMode-inflected =
    .label = 保留变形词（复数 / 过去式 等）
pref-lemmaMode-hint =
    .value = 建议选择「单词原型」，变形词加入生词本易缺少音标和释义。

pref-section-panel = 生词本面板设置
pref-enableWordbookPanel =
    .label = 开启右侧信息栏的生词本面板
pref-panel-hint-platform =
    .value = 仅当生词本平台为本地生词表、Zotero笔记时可使用

pref-section-annotation = 注释设置
pref-enableAnnotationSync =
    .label = 加入生词本时同步添加到注释
pref-enableAnnotationTranslate =
    .label = 自动翻译注释
pref-annotationTranslatePosition = 翻译保存位置：
pref-annotationTranslatePosition-comment =
    .label = 保存翻译至注释评论
pref-annotationTranslatePosition-body =
    .label = 保存翻译至注释正文
pref-annotationTranslatePositionInBody = 翻译保存顺序：
pref-annotationTranslatePositionInBody-before =
    .label = 翻译置于注释正文前
pref-annotationTranslatePositionInBody-after =
    .label = 翻译置于注释正文后
pref-annotationSeparatorMode = 分隔方式：
pref-annotationSeparatorMode-newline =
    .label = 换行
pref-annotationSeparatorMode-separator =
    .label = 分隔符
pref-annotationSeparator-hint = 原文与翻译之间
pref-annotationWordPosition = 单词保存位置：
pref-annotationWordPosition-none =
    .label = 不保存至注释评论
pref-annotationWordPosition-comment =
    .label = 保存至注释评论
pref-annotationMarkType = 标注方式：
pref-annotationMarkType-highlight =
    .label = 高亮文本
pref-annotationMarkType-underline =
    .label = 下划线文本
pref-annotationColor = 标注颜色：
pref-enableAnnotationAutoTag =
    .label = 翻译后自动为注释添加标签
pref-annotationTagName = 标签名称：
pref-hideNoteIcon =
    .label = 隐藏 高亮/下划线文本 便签图标
pref-hideNoteIconMode = 隐藏范围：
pref-hideNoteIconMode-word =
    .label = 仅隐藏单词文本的便签
pref-hideNoteIconMode-all =
    .label = 仅隐藏全部文本的便签
pref-hideNoteIconNotes = 独立便签图标：
pref-hideNoteIconNotes-keep =
    .label = 不隐藏
pref-hideNoteIconNotes-hide =
    .label = 隐藏

pref-section-export = 导出生词本
pref-export-format = 导出格式：
pref-export-format-csv =
    .label = CSV（逗号分隔，Excel 可用）
pref-export-format-tsv =
    .label = TSV（制表符分隔，Anki 可用）
pref-export-format-txt =
    .label = TXT（纯文本）
pref-export-format-json =
    .label = JSON（完整数据结构）
pref-export-autoReveal =
    .label = 导出后自动打开文件管理器定位到文件
pref-export-savePath = 导出路径：
pref-export-savePath-placeholder = 留空则保存在 Zotero 配置目录
pref-export-chooseDir =
    .label = 选择目录
pref-export-chooseDir-label = 选择导出目录
pref-export-btn =
    .label = 导出
pref-maimemoExportHint = 注意：墨墨背单词只能导出单词列表，不含音标/释义。
pref-export-retryHint = 若导出文件内容有问题，可再导出一次

pref-section-other = 其他设置
pref-resetBtn =
    .label = 恢复默认设置
pref-help-link = 使用说明与 Token 申请教程
pref-help = { $name } Build { $version } { $time }
